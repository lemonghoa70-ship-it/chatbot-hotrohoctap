# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TRỢ GIẢNG AI CHẤM BÀI
# ========================================================

# 1. Google Gemini API Key
# Đăng ký và lấy khóa API miễn phí tại: https://aistudio.google.com/app/apikey
# HƯỚNG DẪN: Tạo tệp .env cùng cấp và dán khóa API của bạn vào dòng dưới:
# (Hỗ trợ nhiều khóa phân tách bằng dấu chấm phẩy ; để tự động failover/xoay vòng)
GEMINI_API_KEY=your_gemini_api_key_1;your_gemini_api_key_2

# 2. Cổng dịch vụ Backend (Mặc định: 5000)
PORT=5000

# 3. Model Gemini mặc định (gemini-3.5-flash-lite hoặc gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
